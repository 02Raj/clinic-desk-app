# Expo public env vars (copy to .env and fill in for production)
EXPO_PUBLIC_USE_FIREBASE=false

# Firebase (required when EXPO_PUBLIC_USE_FIREBASE=true)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Default clinic for dev/demo login
EXPO_PUBLIC_DEFAULT_CLINIC_ID=clinic-01
